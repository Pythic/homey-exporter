{
  "uid": "homey-exporter",
  "title": "Homey",
  "tags": [
    "homey",
    "homey-exporter"
  ],
  "timezone": "browser",
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": {
    "from": "now-24h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "DS",
        "label": "Data source",
        "type": "datasource",
        "query": "prometheus",
        "current": {},
        "hide": 0,
        "refresh": 1,
        "regex": "",
        "options": []
      },
      {
        "name": "p1",
        "label": "Energy meter (P1)",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "definition": "label_values(homey_device_measure_power{sub=\"phase1\"}, device_name)",
        "query": {
          "query": "label_values(homey_device_measure_power{sub=\"phase1\"}, device_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": false,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0,
        "description": "Device that reports measure_power.phase1..3 (Homey Energy Dongle or any P1 reader)."
      },
      {
        "name": "boiler_phase",
        "label": "Boiler phase",
        "type": "custom",
        "query": "phase1,phase2,phase3",
        "current": {
          "text": "phase1",
          "value": "phase1"
        },
        "options": [
          {
            "text": "phase1",
            "value": "phase1",
            "selected": true
          },
          {
            "text": "phase2",
            "value": "phase2",
            "selected": false
          },
          {
            "text": "phase3",
            "value": "phase3",
            "selected": false
          }
        ],
        "hide": 0
      },
      {
        "name": "boiler_other",
        "label": "Other metered loads on the boiler phase",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "definition": "label_values(homey_device_measure_power{sub=\"\"}, device_name)",
        "query": {
          "query": "label_values(homey_device_measure_power{sub=\"\"}, device_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0,
        "description": "Devices whose measure_power is subtracted from the boiler phase (e.g. floor heating groups on the same phase)."
      },
      {
        "name": "boiler_base",
        "label": "Baseline on boiler phase (W)",
        "type": "textbox",
        "query": "0",
        "current": {
          "text": "0",
          "value": "0"
        },
        "options": [
          {
            "text": "0",
            "value": "0",
            "selected": true
          }
        ],
        "hide": 0
      },
      {
        "name": "floor",
        "label": "Floor heating groups",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "definition": "label_values(homey_device_measure_power{class=~\"thermostat|socket\"}, device_name)",
        "query": {
          "query": "label_values(homey_device_measure_power{class=~\"thermostat|socket\"}, device_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "room",
        "label": "Rooms",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "definition": "label_values(homey_device_measure_temperature{class=~\"thermostat|sensor\"}, device_name)",
        "query": {
          "query": "label_values(homey_device_measure_temperature{class=~\"thermostat|sensor\"}, device_name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": true,
        "current": {
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        },
        "options": [],
        "hide": 0
      },
      {
        "name": "logic",
        "label": "Logic variables",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "${DS}"
        },
        "definition": "label_values(homey_logic_variable, name)",
        "query": {
          "query": "label_values(homey_logic_variable, name)",
          "refId": "PrometheusVariableQueryEditor-VariableQuery"
        },
        "refresh": 2,
        "sort": 1,
        "multi": true,
        "includeAll": false,
        "current": {},
        "options": [],
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "Grid (P1 meter)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Power per phase",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 1,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "homey_device_measure_power{device_name=\"$p1\", sub=~\"phase.\"}",
          "legendFormat": "{{sub}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": 300000
          },
          "unit": "watt",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      }
    },
    {
      "type": "stat",
      "title": "Power now",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 16,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "homey_device_measure_power{device_name=\"$p1\", sub=\"\"}",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "stat",
      "title": "Imported in range",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 20,
        "y": 1,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "increase(homey_device_meter_power{device_name=\"$p1\", sub=\"imported\"}[$__range])",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "decimals": 1
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "kWh imported from the grid over the selected time range (P1 counter)."
    },
    {
      "type": "bargauge",
      "title": "Current per phase",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 16,
        "y": 5,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "homey_device_measure_current{device_name=\"$p1\", sub=~\"phase.\"}",
          "legendFormat": "{{sub}}",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "amp",
          "min": 0,
          "max": 40,
          "decimals": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 25
              },
              {
                "color": "red",
                "value": 32
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
    {
      "type": "row",
      "title": "Boiler (estimated from one phase)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "Boiler phase: total and boiler estimate",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 0,
        "y": 10,
        "w": 16,
        "h": 8
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "homey_device_measure_power{device_name=\"$p1\", sub=\"$boiler_phase\"}",
          "legendFormat": "$boiler_phase total",
          "refId": "A",
          "range": true,
          "instant": false
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "clamp_min(homey_device_measure_power{device_name=\"$p1\", sub=\"$boiler_phase\"} - on() group_left() (sum(homey_device_measure_power{device_name=~\"$boiler_other\"}) or vector(0)) - $boiler_base, 0)",
          "legendFormat": "boiler (estimate)",
          "refId": "B",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 10,
            "lineWidth": 1,
            "showPoints": "never",
            "spanNulls": 300000
          },
          "unit": "watt",
          "min": 0
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "description": "Boiler estimate = phase power minus the selected other loads on that phase minus the baseline. Pick the phase, the other metered loads and a baseline in the variables at the top."
    },
    {
      "type": "stat",
      "title": "Boiler energy in range",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 16,
        "y": 10,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "avg_over_time((clamp_min(homey_device_measure_power{device_name=\"$p1\", sub=\"$boiler_phase\"} - on() group_left() (sum(homey_device_measure_power{device_name=~\"$boiler_other\"}) or vector(0)) - $boiler_base, 0))[$__range:15s]) * $__range_s / 3600 / 1000",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "kwatth",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "decimals": 2
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      },
      "description": "Integral of the boiler estimate over the selected time range."
    },
    {
      "type": "stat",
      "title": "Boiler now",
      "datasource": {
        "type": "prometheus",
        "uid": "${DS}"
      },
      "gridPos": {
        "x": 16,
        "y": 14,
        "w": 8,
        "h": 4
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "${DS}"
          },
          "expr": "clamp_min(homey_device_measure_power{device_name=\"$p1\", sub=\"$boiler_phase\"} - on() group_left() (sum(homey_device_measure_power{device_name=~\"$boiler_other\"}) or vector(0)) - $boiler_base, 0)",
          "legendFormat": "",
          "refId": "A",
          "range": true,
          "instant": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "watt",
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "decimals": 0
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "area",
        "textMode": "auto"
      }
    },
    {
      "type": "row",
      "title": "Floor heating",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 18,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
